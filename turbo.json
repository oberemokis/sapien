{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": ["NODE_ENV", "VITE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "//#rust:check": {
      "inputs": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "crates/**", "apps/desktop/src-tauri/**", "!apps/desktop/src-tauri/gen/**", "apps/desktop/package.json"],
      "passThroughEnv": ["CARGO_*", "RUSTUP_*"]
    },
    "//#rust:clippy": {
      "inputs": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "crates/**", "apps/desktop/src-tauri/**", "!apps/desktop/src-tauri/gen/**", "apps/desktop/package.json"],
      "passThroughEnv": ["CARGO_*", "RUSTUP_*"]
    },
    "//#rust:fmt": {
      "inputs": ["Cargo.toml", "rust-toolchain.toml", "crates/**/*.rs", "apps/desktop/src-tauri/**/*.rs"],
      "passThroughEnv": ["CARGO_*", "RUSTUP_*"]
    },
    "//#rust:test": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "crates/**",
        "apps/desktop/src-tauri/**",
        "!apps/desktop/src-tauri/gen/**",
        "apps/desktop/package.json",
        "packages/ipc/src/bindings.gen.ts"
      ],
      "passThroughEnv": ["CARGO_*", "RUSTUP_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:web": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
