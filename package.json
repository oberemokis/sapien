{
  "name": "sapien",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev:web",
    "build": "turbo run build",
    "bundle": "pnpm --filter @sapien/desktop tauri build",
    "test": "turbo run test rust:test",
    "typecheck": "turbo run typecheck rust:check",
    "lint": "oxlint && secretlint \"**/*\" --secretlintignore .gitignore && turbo run rust:fmt rust:clippy",
    "rust:check": "cargo check --quiet --workspace --all-targets",
    "rust:clippy": "cargo clippy --workspace --all-targets --quiet -- -D warnings",
    "rust:fmt": "cargo fmt --all --check",
    "rust:test": "cargo test --quiet --workspace",
    "prepare": "husky",
    "audit:deps": "pnpm audit --prod --audit-level high && cargo audit --file Cargo.lock"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "husky": "^9.1.7",
    "oxlint": "^1.72.0",
    "secretlint": "^13.1.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-language-server": "^5.3.0"
  }
}
