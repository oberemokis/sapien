{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sapien",
  "version": "../package.json",
  "identifier": "is.oberemok.sapien",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sapien",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:3400",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sapien"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1MzIyMTlENjc0RkQzMEIKUldRTDAwOW5uU0V5dFRBTGViZlNwRnhTZUU1T1FTQlUySEJ3TXl6d055YlgvSE9vcjBUVUVab28K",
      "endpoints": ["https://github.com/oberemokis/sapien/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/is.oberemok.sapien.policy": "polkit/is.oberemok.sapien.policy"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/polkit-1/actions/is.oberemok.sapien.policy": "polkit/is.oberemok.sapien.policy"
        }
      }
    }
  }
}
