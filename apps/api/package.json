{
  "name": "@sapien/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/app/app.type.ts"
  },
  "imports": {
    "#app/*": "./src/app/*.ts",
    "#core/*": "./src/core/*.ts",
    "#modules/*": "./src/modules/*/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "catalog:",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
