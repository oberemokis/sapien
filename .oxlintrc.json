{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "import",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-default-export": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "unicorn/filename-case": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-shadow": "warn",
    "eslint/no-await-in-loop": "warn",
    "unicorn/require-module-specifiers": "off",
    "eslint/no-ternary": "error",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "react/no-danger": "error"
  },
  "ignorePatterns": [
    "**/src-tauri/target/**",
    "**/src-tauri/gen/**",
    "**/route-tree.gen.ts",
    "**/bindings.gen.ts"
  ],
  "overrides": [
    {
      "files": ["**/*.tsx"],
      "rules": {
        "eslint/no-ternary": "off"
      }
    },
    {
      "files": [
        "**/vite.config.ts",
        "**/vitest.config.ts",
        "**/tsup.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["packages/*/src/{components,flows}/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "@sapien/ipc", "allowTypeImports": true, "message": "команды Rust зовут interactions, экран берёт данные у них" }
            ],
            "patterns": [
              { "regex": "^@tauri-apps/", "allowTypeImports": true, "message": "Tauri живёт в infrastructure" },
              { "regex": "^@sapien/ipc/fake$", "message": "подделка Rust только в тестах и dev:web" },
              { "regex": "^\\.\\./infrastructure(/|$)", "message": "экран берёт данные из interactions, DOM и хранилище лежат под ними" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "@sapien/ipc", "allowTypeImports": true, "message": "store держит состояние без Rust" }
            ],
            "patterns": [
              { "regex": "^@tauri-apps/", "allowTypeImports": true, "message": "Tauri живёт в infrastructure" },
              { "regex": "^@sapien/ipc/fake$", "message": "подделка Rust только в тестах и dev:web" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "@sapien/ipc", "allowTypeImports": true, "message": "ui это вид без домена" }
            ],
            "patterns": [
              { "regex": "^@tauri-apps/", "allowTypeImports": true, "message": "Tauri живёт в infrastructure" },
              { "regex": "^@sapien/ipc/fake$", "message": "подделка Rust только в тестах и dev:web" },
              { "regex": "^\\.\\./(model|interactions|flows|components|infrastructure|store)(/|$)", "message": "ui это вид без домена: данные и подписи ему приносят пропсами" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/model/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "@sapien/ipc", "allowTypeImports": true, "message": "модель это правила показа, данные ей приносят" },
              { "name": "react", "allowTypeImports": true, "message": "модель проверяют без окна: хуки и разметка живут выше" },
              { "name": "react-dom", "allowTypeImports": true, "message": "модель проверяют без окна: хуки и разметка живут выше" }
            ],
            "patterns": [
              { "regex": "^@tauri-apps/", "allowTypeImports": true, "message": "модель не знает Rust" },
              { "regex": "^@tanstack/", "allowTypeImports": true, "message": "модель не знает ни кеша, ни роутера" },
              { "regex": "^@sapien/ipc/fake$", "message": "подделка Rust только в тестах и dev:web" },
              { "regex": "^\\.\\./(interactions|infrastructure|flows|components|ui)(/|$)", "message": "модель это правила показа, данные ей приносят" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/interactions/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "^@tauri-apps/", "allowTypeImports": true, "message": "Tauri живёт в infrastructure, Channel даёт @sapien/ipc" },
              { "regex": "^@sapien/ipc/fake$", "message": "подделка Rust только в тестах и dev:web" },
              { "regex": "^\\.\\./(components|ui|flows)(/|$)", "message": "кеш и запросы лежат под экраном, а не над ним" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/infrastructure/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "^@sapien/ipc/fake$", "message": "подделка Rust только в тестах и dev:web" }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "^@sapien/ipc/fake$", "message": "подделку ставит app/rust.ts, остальному окну она не нужна" }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "@sapien/ipc", "allowTypeImports": true, "message": "страница собирает пакеты, команды Rust зовут их interactions" }
            ],
            "patterns": [
              { "regex": "^@tauri-apps/", "allowTypeImports": true, "message": "Tauri живёт в infrastructure пакетов" },
              { "regex": "^@sapien/ipc/fake$", "message": "подделку ставит app/rust.ts, остальному окну она не нужна" }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/app/rust.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
